{
  "name": "Noticely Embed Widget",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "noticely_embed_widget",

  "overrideCommand": true,

  "workspaceFolder": "/app",

  "shutdownAction": "stopCompose",

  "initializeCommand": [
    "bash",
    "-lc",
    "rm -f /tmp/devcontainer_ready && touch .devcontainer/.docker_bash_history"
  ],
  "onCreateCommand": [
    "bash",
    "-lc",
    "npm install"
  ],
  "updateContentCommand": [
    "bash",
    "-lc",
    "npm install"
  ],
  "postAttachCommand": [
    "bash",
    "-lc",
    "touch /tmp/devcontainer_ready"
  ],

  "remoteEnv": {
    "IN_DEVCONTAINER": "true"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
